#!/bin/sh /etc/rc.common
# Overlay DNS-over-HTTPS forwarder. Starts before dnsmasq (START=19).
# The upstream URL lives only in /etc/doh-rilah.url (mode 0600).
#
# Undo, without that URL:
#   /etc/init.d/doh-proxy stop
#   /etc/init.d/doh-proxy disable
#   uci -q del_list dhcp.dnsmasq.server='127.0.0.1#5053'
#   uci -q delete dhcp.dnsmasq.noresolv
#   uci -q delete dhcp.dnsmasq.localuse
#   uci commit dhcp
#   /etc/init.d/dnsmasq restart
#   rm -f /usr/sbin/dnsproxy /usr/sbin/doh-bootstrap-watch \
#         /etc/dnsproxy.yaml /etc/doh-rilah.url /etc/init.d/doh-proxy
#   remove the genesis-doh block from /etc/firewall.user
#   fw3 restart

START=18
STOP=85
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/dnsproxy --config-path=/etc/dnsproxy.yaml --output=/dev/null
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance

	procd_open_instance
	procd_set_param command /usr/sbin/doh-bootstrap-watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
