#!/bin/sh /etc/rc.common
# Local DNS-over-HTTPS forwarder. Starts before dnsmasq.
# The upstream URL is only in /etc/doh-rilah.url (mode 0600).
# Undo steps: findings/f1-doh-and-tracking-2026-11-06.md

START=18
STOP=85
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/dnsproxy \
		--config-path=/etc/dnsproxy.yaml \
		--output=/dev/null
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance

	procd_open_instance
	procd_set_param command /usr/sbin/doh-bootstrap-watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
